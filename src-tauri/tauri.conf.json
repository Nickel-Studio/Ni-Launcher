{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nickel",
  "mainBinaryName": "ni-launcher",
  "version": "1.0.2",
  "identifier": "studio.nickel.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nickel",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nickel Studio",
    "homepage": "https://github.com/Nickel-Studio/Ni-Launcher",
    "shortDescription": "Minecraft Java 版启动器",
    "copyright": "Copyright (c) 2026 ItzArona, ItzPlana and Nickel contributors",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../LICENSE-ASSETS": "licenses/LICENSE-ASSETS",
      "../NOTICE.md": "licenses/NOTICE.md",
      "../LICENSES/": "licenses/LICENSES/",
      "vendor/minecraft-java-rs-core/LICENSE": "licenses/src-tauri/vendor/minecraft-java-rs-core/LICENSE",
      "../src/assets/fonts/NOTICE.md": "licenses/src/assets/fonts/NOTICE.md",
      "../src/assets/credits/README.md": "licenses/src/assets/credits/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
