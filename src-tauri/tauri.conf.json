{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nickel",
  "mainBinaryName": "ni-launcher",
  "version": "1.0.3-beta",
  "identifier": "studio.nickel.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nickel",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost https://ipc.localhost",
        "img-src": "'self' nickel-image: http://nickel-image.localhost https://nickel-image.localhost data: blob: https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' nickel-video: http://nickel-video.localhost https://nickel-video.localhost data: blob:",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost ws: wss:",
        "img-src": "'self' nickel-image: http://nickel-image.localhost https://nickel-image.localhost data: blob: https: http:",
        "font-src": "'self' data:",
        "media-src": "'self' nickel-video: http://nickel-video.localhost https://nickel-video.localhost data: blob:"
      },
      "headers": {
        "X-Content-Type-Options": "nosniff"
      },
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Nickel Studio",
    "homepage": "https://github.com/Nickel-Studio/Ni-Launcher",
    "shortDescription": "Minecraft Java 版启动器",
    "copyright": "Copyright (c) 2026 ItzArona, ItzPlana and Nickel contributors",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "windows": {
      "wix": {
        "version": "1.0.3.1"
      }
    },
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../LICENSE-ASSETS": "licenses/LICENSE-ASSETS",
      "../NOTICE.md": "licenses/NOTICE.md",
      "../LICENSES/": "licenses/LICENSES/",
      "vendor/minecraft-java-rs-core/LICENSE": "licenses/src-tauri/vendor/minecraft-java-rs-core/LICENSE",
      "../src/assets/fonts/NOTICE.md": "licenses/src/assets/fonts/NOTICE.md",
      "../src/assets/credits/README.md": "licenses/src/assets/credits/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
